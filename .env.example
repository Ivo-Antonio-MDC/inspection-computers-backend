# ─── Aplicação ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
# Origem(ns) do frontend Next.js, separadas por vírgula
FRONTEND_URL=http://localhost:3000

# ─── Base de dados (PostgreSQL) ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=inspeccao_computadores
DB_SSL=false

# ─── JWT — usar strings aleatórias longas em produção (mín. 32 caracteres) ───
ACCESS_TOKEN_SECRET=change_me_min_32_chars_access_secret_xx
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_me_min_32_chars_refresh_secret_x
REFRESH_TOKEN_EXPIRES_DAYS=7

# ─── Seed inicial (npm run seed) ──────────────────────────────────────────────
# Palavra-passe temporária atribuída à equipa de TI; é obrigatório alterá-la
# no primeiro início de sessão.
SEED_DEFAULT_PASSWORD=Inspeccao@2026
SEED_EMAIL_DOMAIN=mdconsultores.co.mz
